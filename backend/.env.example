# --- Required ---
PORT=5000
# Comma-separated list of allowed frontend origins (required in production)
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/socialboost-ai
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_with_a_long_random_string
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
# The lowercase "Cloud name" shown on your Cloudinary dashboard (not your app name)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Optional (defaults shown) ---
# NODE_ENV=production
# JWT_EXPIRES_IN=7d
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=90000
# CLOUDINARY_FOLDER=socialboost
# Number of reverse proxies in front of the API (1 on Render/Railway/Heroku/Nginx)
# TRUST_PROXY=1
# RATE_LIMIT_AUTH_PER_15MIN=20
# RATE_LIMIT_AI_PER_HOUR=60
# RATE_LIMIT_API_PER_15MIN=600
